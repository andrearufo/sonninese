---
import Base from '../layouts/Base.astro';
import { voci, chiave } from '../voci';

const tutte = await voci();
const lettere = Map.groupBy(tutte, (v) => chiave(v.data.lemma)[0].toUpperCase());
const base = import.meta.env.BASE_URL;
---
<Base>
  <p class="intro">
    Parole, locuzioni e modi di dire del dialetto di Sonnino, in provincia di Latina.
    L'archivio conta <strong>{tutte.length}</strong> voci.
  </p>

  <input id="cerca" type="search" placeholder="Cerca una parola o un significato…" aria-label="Cerca" autocomplete="off" />

  <nav class="lettere" aria-label="Lettere">
    {[...lettere.keys()].map((l) => <a href={`#${l}`}>{l}</a>)}
  </nav>

  {[...lettere].map(([l, gruppo]) => (
    <section id={l}>
      <h2>{l}</h2>
      <ul>
        {gruppo.map((v) => (
          <li data-k={chiave(`${v.data.lemma} ${v.data.significato}`)}>
            <a href={`${base}voce/${v.id}/`}>{v.data.lemma}</a>
            <span class="tipo">{v.data.tipo.join(', ')}</span>
            <span class="sig">{v.data.significato}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
  <p id="vuoto" hidden>Nessuna voce trovata.</p>
</Base>

<script>
  const norm = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().trim();
  const input = document.querySelector<HTMLInputElement>('#cerca')!;
  input.addEventListener('input', () => {
    const q = norm(input.value);
    let trovate = 0;
    for (const sec of document.querySelectorAll('section')) {
      let n = 0;
      for (const li of sec.querySelectorAll<HTMLElement>('li')) {
        const ok = li.dataset.k!.includes(q);
        li.hidden = !ok;
        if (ok) n++;
      }
      sec.hidden = n === 0;
      trovate += n;
    }
    document.querySelector<HTMLElement>('#vuoto')!.hidden = trovate > 0;
  });
</script>

<style>
  .intro { margin-top: 0; font-size: 1.125rem; }
  #cerca {
    width: 100%; padding: .75rem 1rem; margin: .5rem 0 1rem;
    font: 1rem var(--sans); color: inherit; background: transparent;
    border: 1px solid var(--riga); border-radius: .5rem;
  }
  #cerca:focus { outline: 2px solid var(--accento); outline-offset: -1px; }
  .lettere { display: flex; flex-wrap: wrap; gap: .25rem; font: .875rem var(--sans); margin-bottom: 1rem; }
  .lettere a { padding: .2rem .45rem; text-decoration: none; border-radius: .25rem; }
  .lettere a:hover { background: var(--riga); }
  h2 { color: var(--accento); font-size: 1.5rem; margin: 2rem 0 .5rem; border-bottom: 1px solid var(--riga); }
  ul { list-style: none; padding: 0; margin: 0; }
  li { padding: .35rem 0; }
  li a { font-weight: 700; text-decoration: none; color: var(--inchiostro); }
  li a:hover { color: var(--accento); }
  li .tipo { font-size: .9rem; margin: 0 .4rem; }
  li .sig::before { content: '— '; color: var(--tenue); }
  #vuoto { color: var(--tenue); }
</style>
